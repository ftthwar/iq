rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Receipts collection
    match /receipts/{receiptId} {
      allow read, write: if true;
    }

    // Users (employees) collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Audit logs collection
    match /auditLogs/{logId} {
      allow read, write: if true;
    }
  }
}
